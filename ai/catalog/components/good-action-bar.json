{
  "$schema": "../component.schema.json",
  "selector": "good-action-bar",
  "className": "GoodActionBarComponent",
  "kind": "component",
  "import": {
    "package": "@goodui/angular",
    "symbol": "GoodActionBarComponent"
  },
  "source": "angular/projects/goodui/src/lib/action-bar.ts",
  "inputs": [
    {
      "name": "groups",
      "type": "readonly GoodActionBarGroup[]",
      "required": false,
      "default": [],
      "allowedValues": null,
      "source": "angular/projects/goodui/src/lib/action-bar.ts",
      "kind": "input"
    },
    {
      "name": "size",
      "type": "GoodButtonSize",
      "required": false,
      "default": "small",
      "allowedValues": [
        "default",
        "small",
        "large"
      ],
      "source": "angular/projects/goodui/src/lib/action-bar.ts",
      "kind": "input"
    },
    {
      "name": "ariaLabel",
      "type": "string",
      "required": false,
      "default": "Actions",
      "allowedValues": null,
      "source": "angular/projects/goodui/src/lib/action-bar.ts",
      "kind": "input"
    }
  ],
  "outputs": [
    {
      "name": "commandSelected",
      "type": "GoodActionBarSelection",
      "source": "angular/projects/goodui/src/lib/action-bar.ts"
    }
  ],
  "variants": {
    "size": [
      "default",
      "small",
      "large"
    ]
  },
  "composition": {
    "projectedContent": [
      "[goodActionBarTools]"
    ],
    "relatedSelectors": [
      "good-action-group",
      "good-button",
      "good-dropdown"
    ],
    "notes": "See source template and component guide for projection slots."
  },
  "forms": {
    "controlValueAccessor": false,
    "validator": false
  },
  "usageGuide": "guides/components/action-bar.md",
  "usage": {
    "summary": "`good-action-bar` puts grouped commands above a workspace. It uses GoodUI Button for visible commands, ActionGroup for their spacing, and Dropdown for the accessible More menu. Project existing Input, Dropdown, or other controls into `[goodActionBarTools]` for search and filters. Command IDs and behavior belong to the application.",
    "examples": []
  },
  "penpot": [],
  "missing": {
    "usageGuide": false,
    "penpotMapping": true
  }
}
