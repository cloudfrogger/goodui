{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cloudfrogger/goodui/blob/ai/catalog/component.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "selector",
    "className",
    "kind",
    "import",
    "source",
    "inputs",
    "outputs",
    "variants",
    "composition",
    "forms",
    "usageGuide",
    "penpot",
    "missing",
    "usage"
  ],
  "properties": {
    "$schema": {
      "const": "../component.schema.json"
    },
    "selector": {
      "type": "string",
      "minLength": 1
    },
    "className": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "component",
        "directive"
      ]
    },
    "import": {
      "$ref": "#/$defs/import"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectedContent",
        "notes",
        "relatedSelectors"
      ],
      "properties": {
        "projectedContent": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "relatedSelectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "forms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlValueAccessor",
        "validator"
      ],
      "properties": {
        "controlValueAccessor": {
          "type": "boolean"
        },
        "validator": {
          "type": "boolean"
        }
      }
    },
    "usageGuide": {
      "type": [
        "string",
        "null"
      ]
    },
    "penpot": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/penpot"
      }
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usageGuide",
        "penpotMapping"
      ],
      "properties": {
        "usageGuide": {
          "type": "boolean"
        },
        "penpotMapping": {
          "type": "boolean"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "examples"
      ],
      "properties": {
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "symbol"
      ],
      "properties": {
        "package": {
          "const": "@goodui/angular"
        },
        "symbol": {
          "type": "string"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required",
        "default",
        "allowedValues",
        "source",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "allowedValues": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "source": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "input",
            "model"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "implicit": {
          "type": "boolean"
        }
      }
    },
    "penpot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "penpotName",
        "penpotId",
        "kind",
        "state",
        "owner"
      ],
      "properties": {
        "penpotName": {
          "type": "string"
        },
        "penpotId": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
