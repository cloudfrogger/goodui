{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "paths": {
      "@cloudfrogger/goodui": [
        "../../angular/dist/goodui"
      ]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "files": [
    "main.ts",
    "login.ts",
    "table-view.ts",
    "edit-form.ts",
    "settings.ts",
    "shell.ts",
    "table-workspace.ts",
    "email-input.ts",
    "select-filter.ts"
  ]
}
